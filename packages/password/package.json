{
  "name": "@teselia/password",
  "version": "0.0.0",
  "description": "Accessible password input with a show/hide button and live requirements, shipped as a framework-agnostic Web Component. Works with password managers. WCAG 2.2 AA by default.",
  "keywords": [
    "password",
    "password-input",
    "show-password",
    "password-requirements",
    "web-component",
    "custom-element",
    "accessibility",
    "a11y",
    "wcag",
    "vue"
  ],
  "license": "MIT",
  "author": "caicesardev",
  "homepage": "https://teselia.caicesardev.com/password",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caicesardev/teselia.git",
    "directory": "packages/password"
  },
  "bugs": {
    "url": "https://github.com/caicesardev/teselia/issues"
  },
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/tes-password.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tes-password.js"
    },
    "./iife": "./dist/tes-password.iife.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/tes-password.iife.js",
  "jsdelivr": "./dist/tes-password.iife.js",
  "scripts": {
    "build": "vite build && vite build --mode iife && vue-tsc -p tsconfig.build.json && node ../../scripts/check-public-types.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@teselia/shared": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
