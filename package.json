{
  "name": "teselia-monorepo",
  "private": true,
  "description": "Teselia: accessible micro components built with Vue 3, shipped as framework-agnostic Web Components.",
  "license": "MIT",
  "author": "caicesardev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caicesardev/teselia.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
